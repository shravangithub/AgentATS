/* Optional demo writer — adapt cell refs to your own sheet layout, or delete. */
function tr_scoreActiveRow() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  // expects selectors in B4:B7 and 37 scores in F14:F50 — change to match your ATS
  const role = sh.getRange("B4").getValue(), company = sh.getRange("B5").getValue();
  const threshold = sh.getRange("B6").getValue(), gate = sh.getRange("B7").getValue();
  const scores = {}; TalentRubric.categories().forEach((c, i) => scores[c] = sh.getRange(14 + i, 6).getValue());
  const r = TalentRubric.scoreCandidate(role, company, threshold, gate, scores);
  sh.getRange("B9").setValue(r.composite); sh.getRange("B11").setValue(r.verdict);
}
