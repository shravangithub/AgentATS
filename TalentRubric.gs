  function scoreCandidate(role, company, threshold, gatePass, scores) {
    const cats = ENGINE.categories;
    const rw = ENGINE.roleWeights[role];
    const cm = ENGINE.companyModifiers[company];
    if (!rw) throw new Error("Unknown role archetype: " + role);
    if (!cm) throw new Error("Unknown company archetype: " + company);

    let rawTotal = 0; const raw = {};
    cats.forEach(c => { raw[c] = (rw[c] || 0) * (cm[c] || 1); rawTotal += raw[c]; });

    let composite = 0; const eff = {};
    cats.forEach(c => {
      const w = rawTotal ? (raw[c] / rawTotal) * 100 : 0;
      eff[c] = Math.round(w * 100) / 100;
      const s = (scores && scores[c] != null) ? Number(scores[c]) : 0;
      composite += w * s / 5;
    });

    const minReq = ENGINE.thresholds[threshold];
    let verdict;
    if (gatePass === false || gatePass === "No")   verdict = "REJECT - gate fail";
    else if (composite >= minReq)                  verdict = "SHORTLIST";
    else if (composite >= minReq - 12)             verdict = "REVIEW";
    else                                           verdict = "REJECT";

    const topCats = Object.keys(eff).sort((a, b) => eff[b] - eff[a]).slice(0, 5);
    return { composite: Math.round(composite * 10) / 10, minRequired: minReq, verdict: verdict,
             effectiveWeights: eff, topCategories: topCats };
  }

  function rankCandidates(list) {
    return list
      .map(c => Object.assign({}, c, scoreCandidate(c.role, c.company, c.threshold, c.gatePass, c.scores)))
      .sort((a, b) => b.composite - a.composite);
  }

  // optional: override the embedded tables from imported Sheet tabs (bound projects only)
  function loadFromSheets(ss) {
    function readMatrix(name) {
      const v = ss.getSheetByName(name).getDataRange().getValues();
      const headers = v[0].slice(1); const out = {}; headers.forEach(h => out[h] = {});
      for (let r = 1; r < v.length; r++) {
        const cat = v[r][0]; if (!cat || /total/i.test(cat)) continue;
        headers.forEach((h, i) => { out[h][cat] = Number(v[r][i + 1]); });
      }
      return out;
    }
    ENGINE.roleWeights = readMatrix("03_Role_Weights");
    ENGINE.companyModifiers = readMatrix("06_Company_Modifiers");
    ENGINE.categories = Object.keys(ENGINE.roleWeights[Object.keys(ENGINE.roleWeights)[0]]);
    return ENGINE;
  }

  return {
    scoreCandidate: scoreCandidate,
    rankCandidates: rankCandidates,
    loadFromSheets: loadFromSheets,
    roleWeights: function () { return ENGINE.roleWeights; },
    companyModifiers: function () { return ENGINE.companyModifiers; },
    categories: function () { return ENGINE.categories; },
    options: function () {
      return { archetypes: ENGINE.archetypes, companies: ENGINE.companies,
               thresholds: Object.keys(ENGINE.thresholds) };
    }
  };
})();

